# Two ways to configure this: these variables, or factory.toml (see factory.toml.example).
# Environment wins wherever they disagree. This file is loaded via --env-file-if-exists before any
# application code runs, so anything set here behaves as ordinary environment.
#
# FACTORY_CONFIG=/path/to/factory.toml reads the TOML from somewhere other than the repo root.
# Unset, the repo-root factory.toml is used if present, and its absence is not an error.
#
# Careful with blank values below: an empty variable is treated as unset when merging with
# factory.toml, so `HOST=` here will not blank out a host set in the file.

# Fine-grained PAT. OPTIONAL: without one the dashboard never fetches and serves whatever is
# already in the database. DATA_SOURCE used to switch to a replayed payload here; it is gone, and
# setting it is now a hard error rather than being ignored. For data with no token, seed a
# disposable database instead: npm run seed
#
# Required scopes when you do set it:
#   Metadata: read
#   Pull requests: read
#   Contents: read   <- only for the revert rate; without it that one metric reports "unavailable"
GITHUB_TOKEN=

# Where a bare entry in ORG_REPOS looks for its repo. Unrelated to the organization's identity.
GITHUB_OWNER=Bellows-AI

# The organization these figures belong to. One per deployment; the dashboard's selector is inert
# until accounts exist. ORG_ID is a KEY — it leads every stored primary key and travels as `?org=`
# — so it is lowercase letters, digits, "-" and "_" only, may not begin with "__", and is rejected
# rather than normalised. Changing it points the dashboard at an empty partition. Defaults to
# "default"; ORG_NAME defaults to GITHUB_OWNER.
ORG_ID=default
ORG_NAME=

# Comma-separated; the landing page reports them all combined. A bare name takes GITHUB_OWNER,
# a qualified "other-owner/name" keeps its own — so one organization can span GitHub owners.
#
# This was GITHUB_REPOS. That name is now FATAL rather than ignored: a variable that used to be
# meaningful and is quietly dropped would revert a two-repo dashboard to one repo and still render.
ORG_REPOS=factory

# Where this organization's checkouts live: one clone per repo above, at
# `<root>/<ORG_ID>/<repo name>`, cloned in the background at boot. Absolute, or starting with "~/";
# a relative path is rejected rather than resolved. Unset means nothing is cloned.
#
# docker-compose.yml defaults this to /workspaces and mounts a named volume there, so the container
# checks out on first `up` whether or not this line is set. Set it empty to stop that.
#
# Only ever adds: an existing checkout is never fetched or overwritten, and dropping a repo from
# ORG_REPOS leaves its directory behind.
ORG_WORKSPACE_ROOT=

BASE_BRANCH=dev

# The only cache floor: an incremental sync costs a few rate-limit points per repo, so 60 per repo.
# CACHE_TTL_SECONDS is gone and is a hard error if set.
SYNC_TTL_SECONDS=60

# REQUIRED. The database is the only source the dashboard reads.
DATABASE_URL=postgres://factory:factory@127.0.0.1:5432/factory_dev

PORT=8080
HOST=127.0.0.1

# Comma-separated. Reviewers in this list are classed as bots.
BOTS=claude,claude[bot],github-actions,github-actions[bot],bellows-frontend-fix-bot

# --- Authentication ------------------------------------------------------------------------
#
# `none` (the default) means no application-level auth at all: every route is open to anyone who
# can reach the port, including POST /api/jobs, which runs shell commands. `github` requires a
# signed-in member. An EXPLICIT enum — setting a client id and forgetting this leaves the
# deployment open rather than half-enabled. See docs/auth.md.
#
# Read by `npm run dev` and the CLIs. `docker compose` ignores it and pins `github`, so the four
# keys below are REQUIRED to bring that stack up at all — a missing one is fatal and names itself.
AUTH_MODE=none

# Register an OAuth App (not a GitHub App) with the callback set to <PUBLIC_URL>/api/auth/github/
# callback. No scopes are requested: membership is Factory's, not GitHub's.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# At least 32 characters. Signs the session cookie, so rotating it logs everyone out.
SESSION_SECRET=

# The absolute origin GitHub redirects back to. Defaults to http://<HOST>:<PORT> for a loopback
# bind and is REQUIRED otherwise — it cannot be derived from the request's Host header without
# letting the caller choose the redirect target.
PUBLIC_URL=

# Whether the session cookie carries `Secure`. Leave off for http://127.0.0.1; turn it on behind
# TLS. Not derived from the request, because that means trusting X-Forwarded-Proto from anyone.
COOKIE_SECURE=0

# A GitHub login made an admin at boot, and ONLY when the organization has no members at all.
# Without it, turning auth on for the first time locks everybody out with nothing in the log.
# After that, use: npm run invite -- --login <login> --role admin
AUTH_BOOTSTRAP_ADMIN=

# Members of this GitHub organization admit themselves, as ordinary members, the first time they
# sign in — onboarding is "add them to the org" rather than a second roster kept in step by hand.
# Empty keeps invite-only membership. Invites still work either way, which is how somebody outside
# the org gets in. Costs the zero-scopes property: read:org is requested when this is set, so the
# consent screen changes and each sign-in makes one extra GitHub call. See docs/auth.md.
AUTH_AUTO_JOIN_GITHUB_ORG=

# Optional shared secret for the telemetry ingest routes, sent as X-Factory-Ingest-Token. Unset
# leaves them open, which is what the collector and the laptop plugin expect today.
INGEST_TOKEN=

# Only needed if AUTH_MODE=none has to run on a HOST that is not loopback — it asserts that
# something in front of this port is doing the authenticating. docker-compose.yml sets it because
# the image binds 0.0.0.0 and the isolation is compose's 127.0.0.1 publish.
AUTH_ALLOW_PUBLIC_BIND=

# The driver's credential against a board running AUTH_MODE=github.
# Mint with: npm run worker-token -- --name driver-1
JOB_BOARD_TOKEN=
