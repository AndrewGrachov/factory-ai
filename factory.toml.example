# Copy to factory.toml and chmod 600 — it holds a GitHub App private key.
#
#     cp factory.toml.example factory.toml && chmod 600 factory.toml
#
# Every key here can be overridden by the matching environment variable, so `.env` and
# `docker compose` keep working unchanged and win where they disagree. Set FACTORY_CONFIG to read
# this from somewhere else; the file is optional and its absence is not an error.
#
# An unknown or misspelled key here is fatal, unlike an unrecognised environment variable: a
# tolerated typo would boot the dashboard on fixture data and look like a missing token.

[organization]
# Who these figures belong to. One organization per deployment: there are no accounts yet, so
# nothing selects between organizations and the selector in the upper right of the dashboard is
# deliberately inert.
#
# `id` is a KEY, not a label — it leads every stored primary key and travels in the `?org=` query
# parameter — so it is restricted to lowercase letters, digits, "-" and "_", may not begin with
# "__", and anything outside that is rejected rather than quietly cleaned up. Changing it points
# the dashboard at a different, empty partition, which looks exactly like data loss. Pick it once.
# Defaults to "default".
id = "acme"

# Display only, and the one thing shown in the selector. Defaults to `id` above, because a selector
# reading "default" looks like a bug.
name = "Acme Inc"

# There is no `repos` key. The list is whatever the GitHub App installation below reports, so
# granting the App a repository is the only place that decision is made — a second copy here would
# be a roster to keep in step with the credential, and a repo in one but not the other used to fail
# every sync with a 404 that read as a deleted repository.
#
# Cost still scales: a full reconciliation is ~243 rate-limit points PER repo against a 5000/hour
# budget, so the sync TTL floor below is raised by the number of repositories the App can see.

# Where members' checkouts live: one clone per repo each person selected, at
# `<workspace_root>/<id>/<user id>/<repo name>`. Cloned in the background when somebody picks
# repositories from the dashboard — boot itself checks nothing out.
#
# Absolute, or starting with "~/"; a relative path is rejected rather than resolved, since it would
# mean a different directory from the repo root, from server/, and in the container. Unset by
# default, which means nothing is cloned at all and the Workspace page says so.
#
# Only ever adds. An existing checkout is never fetched or overwritten — it may hold uncommitted
# work belonging to an agent session — and deselecting a repo leaves its directory behind.
# workspace_root = "~/.factory-ai/workspaces"

[github]
# The repo-read credential AND the source of the repo list, both from one GitHub App installation.
#
# `app` (the default) reads GitHub. `none` reads nothing: the dashboard serves whatever is already
# in the database, which is how the browser check and a seeded demo run — see `npm run seed`. An
# EXPLICIT enum, never inferred from whether an app id happens to be set, so a deployment cannot
# arrive at "fetches nothing" by mistyping a key. `app` with `app_id` or the private key missing is
# fatal and names the one that is missing.
#
# `token` and `owner` used to live here. Both are gone and both are fatal if set.
mode = "app"

# Register a GitHub App, install it on the organization whose repositories you want measured, and
# give it three read permissions:
#
#   Metadata: read
#   Pull requests: read
#   Contents: read   <- only for the revert rate; without it that one metric reports "unavailable"
#
# The numeric id or the `Iv23li…` client id; both are accepted as the JWT issuer.
app_id = "123456"

# Optional. Left out, it is discovered — but only when the App is installed in exactly one place.
# Zero or several is fatal, because guessing would silently measure the wrong organization.
# installation_id = "12345678"

# The private key GitHub generated, inline or as base64. chmod 600 this file if you put it here;
# the boot warning about that is not decorative. This key is worse to leak than a PAT was: it mints
# installation tokens indefinitely, and rotating it means generating a new one in GitHub's UI.
private_key = ""

# Or keep the .pem on disk and point at it. Read by the config layer before validation, so that
# loadConfig stays a pure function of its argument and never touches the filesystem.
# private_key_file = "/etc/factory/app.pem"

base_branch = "dev"

# Reviewers listed here are classed as bots. An entry cannot contain a comma.
bots = ["claude", "claude[bot]", "github-actions", "github-actions[bot]", "bellows-frontend-fix-bot"]

[server]
port = 8080
host = "127.0.0.1"

[cache]
# The only cache floor. History is always persisted, so the ordinary refresh is an incremental walk
# of a few pages rather than a full one — 60 per repo. The expensive full reconciliation is not
# gated by this: it runs daily and refuses to start unless the remaining rate-limit budget actually
# covers it. (`ttl_seconds` is gone, and setting it is a hard error rather than being ignored.)
sync_ttl_seconds = 60

[telemetry]
# `postgres` reports real sessions; `fixture` serves synthetic numbers the UI badges as such;
# `off` renders no AI panels at all.
source = "postgres"

# REQUIRED, always — the database is the only source the dashboard reads, for pull requests as well
# as telemetry. A name ending in _test/_seed/_synthetic/_demo/_e2e is treated as disposable and is
# refused whenever `github.mode` is "app", because `npm run seed` and `npm run test:db` both destroy
# or counterfeit whatever is in one.
database_url = "postgres://factory:factory@127.0.0.1:5432/factory_dev"

# No quota to protect here, only a hot loop to prevent, so the floor is 5 rather than 60.
ttl_seconds = 30

[auth]
# `none` (the default) leaves every route open and makes the bind address the access control, as it
# always was. `github` requires a signed-in member. An EXPLICIT enum, never inferred from whether a
# client id happens to be set: a mode reached by typo is the one failure nobody notices. Setting
# `github` with any of the three keys below missing is fatal and names the missing one, rather than
# quietly degrading to an open deployment. See docs/auth.md.
mode = "none"

# From an OAuth App — a SECOND registration, separate from the GitHub App in [github] above — with
# the callback at <public_url>/api/auth/github/callback. No scopes are requested: membership is
# Factory's, not GitHub's, so `read:org` buys nothing. Two registrations on purpose: signing
# somebody in needs no scopes at all, while reading repositories needs installation permissions,
# and one credential doing both would mean every person who signs in grants repository access.
# chmod 600 this file if you put a secret here; the boot warning about that is not decorative.
github_client_id = ""
github_client_secret = ""

# At least 32 characters. Signs the session cookie, so rotating it logs everyone out.
session_secret = ""

# The absolute origin GitHub redirects back to. Defaults to http://<host>:<port> for a loopback
# bind, required otherwise. Never derived from the request's Host header — that would let the
# caller choose the redirect target.
public_url = ""

# Unquoted booleans, like unquoted integers: `cookie_secure = "true"` is rejected.
cookie_secure = false

# Fourteen days.
session_ttl_hours = 336

# A GitHub login made an admin at boot, and only when the organization has no members at all — the
# one thing standing between turning auth on and locking everybody out. Afterwards use
# `npm run invite`.
bootstrap_admin = ""

# Members of this GitHub organization admit themselves, as ordinary members, on first sign-in.
# Empty keeps invite-only membership; invites keep working either way, which is how somebody
# outside the org gets in. Costs the zero-scopes property — read:org is requested when it is set.
auto_join_github_org = ""

# Optional shared secret for the telemetry ingest routes (X-Factory-Ingest-Token). Unset leaves
# them open, which is what the collector and the laptop plugin expect.
ingest_token = ""
