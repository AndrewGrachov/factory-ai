{
    "name": "factory-ai",
    "private": true,
    "type": "module",
    "workspaces": [
        "core",
        "server",
        "web"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "npm run build -w core && npm run build -w server && npm run build -w web",
        "dev": "npm run build -w core && concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
        "dev:server": "npm run dev -w server",
        "dev:web": "npm run dev -w web",
        "start": "node --env-file-if-exists=.env server/dist/index.js",
        "test": "vitest run",
        "test:db": "vitest run --config vitest.db.config.ts",
        "verify:ui": "playwright test",
        "typecheck": "tsc -b",
        "backfill": "npm run build -w core && npm run build -w server && node server/dist/backfill/cli.js"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "@types/node": "^24.0.0",
        "concurrently": "^9.1.2",
        "typescript": "^5.7.0",
        "vitest": "^3.0.0"
    }
}
