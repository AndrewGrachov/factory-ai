{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["vite/client"],
        "emitDeclarationOnly": true,
        "outDir": "dist-types",
        "rootDir": "src"
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "references": [{ "path": "../core" }]
}
